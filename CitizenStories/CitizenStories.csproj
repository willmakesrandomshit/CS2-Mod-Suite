<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$(CSII_TOOLPATH)</CS2ToolPath>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-alpha.1</InformationalVersion>
  </PropertyGroup>
  <Import Project="$(CS2ToolPath)\Mod.props" />
  <Import Project="$(CS2ToolPath)\Mod.targets" />
  <ItemGroup>
    <Analyzer Remove="$(EntityPackagePath)\*.dll" />
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="BuildUI" BeforeTargets="BeforeBuild">
    <Exec WorkingDirectory="UI" Command="npm run build" />
  </Target>
  <Target Name="DeployCitizenStoriesFiles" AfterTargets="DeployWIP">
    <ItemGroup>
      <CitizenStoriesFiles Include="UI\dist\CitizenStories.mjs;UI\mod.json" />
      <CitizenStoriesIconFiles Include="UI\dist\images\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CitizenStoriesFiles)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CitizenStoriesIconFiles)" DestinationFiles="@(CitizenStoriesIconFiles->'$(DeployDir)\images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CleanEmptyCitizenStoriesBurstOutputs" AfterTargets="DeployWIP;DeployCitizenStoriesFiles">
    <Delete Files="$(DeployDir)\CitizenStories_win_x86_64.dll;$(DeployDir)\CitizenStories_mac_x86_64.bundle;$(DeployDir)\CitizenStories_linux_x86_64.so;$(DeployDir)\CitizenStories.pdb" />
  </Target>
  <ItemGroup>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
    <Reference Include="System.Data"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
</Project>
