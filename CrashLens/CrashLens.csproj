<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$(CSII_TOOLPATH)</CS2ToolPath>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <Version>1.1.4-beta.1</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4-beta.1</InformationalVersion>
  </PropertyGroup>
  <Import Project="$(CS2ToolPath)\Mod.props" />
  <Import Project="$(CS2ToolPath)\Mod.targets" />
  <ItemGroup>
    <Analyzer Remove="$(EntityPackagePath)\*.dll" />
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="BuildUI" BeforeTargets="BeforeBuild">
    <Exec WorkingDirectory="UI" Command="npm run build" />
  </Target>
  <Target Name="DeployCrashLensFiles" AfterTargets="DeployWIP">
    <ItemGroup>
      <CrashLensFiles Include="UI\dist\CrashLens.mjs;UI\mod.json" />
      <CrashLensIconFiles Include="UI\dist\images\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CrashLensFiles)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CrashLensIconFiles)" DestinationFiles="@(CrashLensIconFiles->'$(DeployDir)\images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Delete Files="$(DeployDir)\Source-v1.1.2.zip;$(DeployDir)\Source-v1.1.3.zip;$(DeployDir)\source\Source-v1.1.2.zip;$(DeployDir)\source\Source-v1.1.3.zip" />
  </Target>
  <Target Name="CleanEmptyCrashLensBurstOutputs" AfterTargets="DeployWIP;DeployCrashLensFiles">
    <Delete Files="$(DeployDir)\CrashLens_win_x86_64.dll;$(DeployDir)\CrashLens_mac_x86_64.bundle;$(DeployDir)\CrashLens_linux_x86_64.so;$(DeployDir)\CrashLens.pdb;$(DeployDir)\Source-v1.1.2.zip;$(DeployDir)\Source-v1.1.3.zip;$(DeployDir)\source\Source-v1.1.2.zip;$(DeployDir)\source\Source-v1.1.3.zip" />
  </Target>
  <ItemGroup>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
    <Reference Update="System.Data"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
</Project>
