<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$(CSII_TOOLPATH)</CS2ToolPath>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <Version>1.1.4-beta.1</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4-beta.1</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <TownRoadLanePath Condition="'$(TownRoadLanePath)' == '' AND Exists('$(LOCALAPPDATA)Low\Colossal Order\Cities Skylines II\.cache\Mods\pdx_mods\150863_11\TownRoadLane.dll')">$(LOCALAPPDATA)Low\Colossal Order\Cities Skylines II\.cache\Mods\pdx_mods\150863_11\TownRoadLane.dll</TownRoadLanePath>
    <TownRoadLanePath Condition="'$(TownRoadLanePath)' == ''">..\references\town-road-lane\src\TownRoadLane\bin\Release\net48\TownRoadLane.dll</TownRoadLanePath>
  </PropertyGroup>
  <Import Project="$(CS2ToolPath)\Mod.props" />
  <Import Project="$(CS2ToolPath)\Mod.targets" />
  <ItemGroup>
    <Analyzer Remove="$(EntityPackagePath)\*.dll" />
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="TownRoadLane" HintPath="$(TownRoadLanePath)"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
    <Reference Update="System.Data"><Private>false</Private></Reference>
    <Reference Update="System.Xml"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
  <Target Name="BuildUI" BeforeTargets="BeforeBuild" Condition="Exists('UI\node_modules')">
    <Exec WorkingDirectory="UI" Command="npm run build" />
  </Target>
  <Target Name="DeployUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true' AND '$(DeployDir)' != ''">
    <ItemGroup>
      <UIFiles Include="UI\dist\JunctionStudio.mjs;UI\dist\JunctionStudio.mjs.LICENSE.txt" />
      <UIImages Include="UI\dist\images\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UIFiles)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="UI\mod.json" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="@(UIImages)" DestinationFiles="@(UIImages->'$(DeployDir)\images\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CleanEmptyJunctionStudioBurstOutputs" AfterTargets="DeployWIP;DeployUI">
    <Delete Files="$(DeployDir)\JunctionStudio_win_x86_64.dll;$(DeployDir)\JunctionStudio_mac_x86_64.bundle;$(DeployDir)\JunctionStudio_linux_x86_64.so;$(DeployDir)\JunctionStudio.pdb" />
  </Target>
</Project>
